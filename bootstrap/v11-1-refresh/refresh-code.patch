+/* Pure integer policies; both sides share exactly the same rules. */
+static s32 AscensionRefresh_DamageValue(s32 raw, bool8 career, bool8 wet,
+    bool8 waterMove, bool8 raining, bool8 fixedDamage, bool8 retaliation)
+{
+    if (!career || raw <= 0 || retaliation) return raw;
+    /* A rain bonus already exists in native damage. Do not multiply it twice. */
+    if (wet && waterMove && !raining && !fixedDamage) raw = raw * 120 / 100;
+    return (raw + 1) / 2;
+}
+static u16 AscensionRefresh_SpeedValue(u16 speed, bool8 career, bool8 wet,
+    bool8 grounded, bool8 waterType)
+{
+    if (!career || !wet || !grounded) return speed;
+    return waterType ? speed * 115 / 100 : speed * 3 / 4;
+}
