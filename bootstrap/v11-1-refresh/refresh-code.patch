+static void RefreshMap_Draw(u8 id)
+{
+    u8 win=gTasks[id].data[0],page=gTasks[id].data[1],i;
+    const struct RefreshMapMarker *markers=page?sRefreshMarkers1:sRefreshMarkers0;
+    u8 count=page?ARRAY_COUNT(sRefreshMarkers1):ARRAY_COUNT(sRefreshMarkers0);
+    FillWindowPixelBuffer(win,PIXEL_FILL(1));
+    RefreshMap_Print(win,0,0,page?sRefreshTitleEast:sRefreshTitleWest);
+    BlitBitmapToWindow(win,page?sRefreshMap1:sRefreshMap0,0,16,112,112);
+    for(i=0;i<count;i++)
+    {
+        u8 label[4]={CHAR_1+i,EOS};
+        FillWindowPixelRect(win,PIXEL_FILL(1),markers[i].x-2,markers[i].y+12,8,10);
+        RefreshMap_Print(win,markers[i].x-1,markers[i].y+11,label);
+        RefreshMap_Print(win,115,17+i*12,label);
+        RefreshMap_Print(win,125,17+i*12,markers[i].name);
+    }
+    RefreshMap_Print(win,0,131,sRefreshFooter);
+    PutWindowTilemap(win);CopyWindowToVram(win,COPYWIN_FULL);
+}
+static void Task_RefreshMap(u8 id)
+{
+    if(gPaletteFade.active)return;
+    if(gTasks[id].data[2])
+    {FreeAllWindowBuffers();DestroyTask(id);SetMainCallback2(CB2_ReturnToFieldWithOpenMenu);return;}
+    if(JOY_NEW(B_BUTTON|START_BUTTON))
+    {gTasks[id].data[2]=1;BeginNormalPaletteFade(PALETTES_ALL,0,0,16,RGB_BLACK);return;}
+    if(JOY_NEW(L_BUTTON|R_BUTTON|DPAD_LEFT|DPAD_RIGHT))
+    {gTasks[id].data[1]^=1;RefreshMap_Draw(id);PlaySE(SE_SELECT);}
+}
