+static bool8 AscensionRefresh_Wet(u8 side)
+{
+    u32 i;
+    s16 x=sArena.bodies[side].x/Q,y=sArena.bodies[side].y/Q;
+    if(!ElementGrounded(side))return FALSE;
+    if(RealtimeArena_IsFlooded(x,y))return TRUE;
+    for(i=0;i<ELEMENT_COUNT;i++)
+        if((sSurfaces[i].kind==SURFACE_WATER||sSurfaces[i].kind==SURFACE_CHARGED)
+           && sSurfaces[i].life && sSurfaces[i].sprite<MAX_SPRITES
+           && ElementContains(&sSurfaces[i],x,y))return TRUE;
+    return FALSE;
+}
