# V5 runtime progression diagnostic: verify sendout exits before movement checks.
# V5 movement diagnostic: pure RIGHT input must move the native Arena body.
frames 300 0
snap 00-title
press 8
frames 120 0
press 1
frames 1100 0
snap 01-lab
press 768
frames 700 0
expect gWildlandsWorldAudit 0 4 1
expect gWildlandsWorldAudit 20 4 2
expect gWildlandsWorldAudit 28 4 1
expect gWildlandsPartnerTelemetry 0 4 1
snap 02-world-start
# Use 1-frame samples while Right is held: the existing snapshots were
# taken only after frames() released the key, so zero heldKeys was expected.
frames 1 16
snap 02a-first-right-frame
frames 29 16
snap 02a-move-30
frames 60 16
snap 02b-move-90
frames 90 16
snap 02c-move-180
expect gWildlandsWorldAudit 4 4 1
expect gWildlandsWorldAudit 8 4 1
expect gWildlandsWorldAudit 20 4 2
snap 03-crossing-fire
frames 14 18
frames 45 16
snap 04-after-dodge
frames 80 128
snap 05-water-probe
frames 120 64
snap 06-grass-probe

# ---- Gate B cadence (wl_smoke): Arena updates per emulated frame ----
# Render cadence is informational (min 0); the gate is simulation steps per
# emulated frame (fixed-timestep catch-up keeps game time real-time).
rate render-idle 300 0 0
ratesym idle gWildlandsProfile 20 2 300 0 95
ratesym right gWildlandsProfile 20 2 300 16 95
ratesym down gWildlandsProfile 20 2 240 128 95
ratesym left gWildlandsProfile 20 2 300 32 95
ratesym up gWildlandsProfile 20 2 240 64 95
ratesym attack gWildlandsProfile 20 2 180 1 95
dump frame gArenaFrameTelemetry 10
dump render gArenaRenderTelemetry 4
dump world gWildlandsWorldTelemetry 16
dump audit gWildlandsWorldAudit 8
snap 07-after-cadence
dump profile1 gWildlandsProfile 6
# ---- Gate G live map: START -> MAP (5th entry) ----
press 8
press 128
press 128
press 128
press 128
snap 11-pause-menu
press 1
frames 20 0
snap 12-live-map
dump map gWildlandsMapTelemetry 4
expectmin gWildlandsMapTelemetry 0 4 1
press 2
press 2
frames 60 0
snap 13-resumed

# ---- Gate E closing zone: exploration ends, next circle announced ----
dump zone0 gWildlandsZoneTelemetry 16
frames 7800 0
snap 10-zone-warning
dump zone1 gWildlandsZoneTelemetry 16
expectmin gWildlandsZoneTelemetry 0 4 1
expectmin gWildlandsZoneTelemetry 56 4 1
dump profile2 gWildlandsProfile 6
# ---- Gate D true duo combat (squad wings are battlers 2 and 3) ----
dump squad0 gWildlandsSquadTelemetry 16
expect gWildlandsSquadTelemetry 0 4 3
frames 240 16
frames 900 0
snap 08-duo-fight
dump squad1 gWildlandsSquadTelemetry 16
dump realtime gRealtimeArenaTelemetry 8
expectmin gWildlandsSquadTelemetry 4 4 1
expectmin gWildlandsSquadTelemetry 8 4 1
expectmax gWildlandsSquadTelemetry 60 4 0
frames 900 1
snap 09-duo-fight-attacking
dump squad2 gWildlandsSquadTelemetry 16
dump profile gWildlandsProfile 4
# ---- Gate F pickups: spot 0 lies on the bridge lane walked above ----
dump loot gWildlandsLootTelemetry 12
expectmin gWildlandsLootTelemetry 0 4 1
expect gWildlandsLootTelemetry 44 4 0
